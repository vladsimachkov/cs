#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

failed=0

echo -e "${YELLOW}[pre-commit]${NC} Running checks..."

# This workspace builds inside Docker (AGENTS.md §3.5); a host cargo is optional.
# Skip rather than abort, so `make install-hooks` is safe on a machine without Rust.
if ! command -v cargo >/dev/null 2>&1; then
    echo -e "${YELLOW}cargo not on this host; skipping the pre-commit cargo checks.${NC}"
    echo -e "${YELLOW}Run 'scripts/docker.sh check-safe' before committing (AGENTS.md §3.5).${NC}"
    exit 0
fi

# 1. Cargo.lock vs manifests (the lock is committed; AGENTS.md §3.1)
echo -e "${YELLOW}[1/5]${NC} cargo metadata --locked"
if ! cargo metadata --locked --format-version 1 >/dev/null 2>&1; then
    echo -e "${RED}✗ Cargo.lock does not match the manifests. Run 'cargo update -p <crate>' and commit it.${NC}"
    failed=1
else
    echo -e "${GREEN}✓ Cargo.lock${NC}"
fi

# 2. cargo fmt -- check
echo -e "${YELLOW}[2/5]${NC} cargo fmt --check"
if ! cargo fmt --all -- --check 2>/dev/null; then
    echo -e "${RED}✗ cargo fmt failed. Run 'cargo fmt --all' to fix.${NC}"
    failed=1
else
    echo -e "${GREEN}✓ cargo fmt${NC}"
fi

# 3. cargo clippy (same flags as CI and the Makefile)
echo -e "${YELLOW}[3/5]${NC} cargo clippy"
if ! cargo clippy --workspace --all-targets --all-features -- -D warnings 2>/dev/null; then
    echo -e "${RED}✗ cargo clippy found warnings/errors.${NC}"
    failed=1
else
    echo -e "${GREEN}✓ cargo clippy${NC}"
fi

# 4. cargo check
echo -e "${YELLOW}[4/5]${NC} cargo check"
if ! cargo check --workspace 2>/dev/null; then
    echo -e "${RED}✗ cargo check failed.${NC}"
    failed=1
else
    echo -e "${GREEN}✓ cargo check${NC}"
fi

# 5. cargo test
echo -e "${YELLOW}[5/5]${NC} cargo test"
if ! cargo test --workspace --no-fail-fast 2>/dev/null; then
    echo -e "${RED}✗ cargo test failed.${NC}"
    failed=1
else
    echo -e "${GREEN}✓ cargo test${NC}"
fi

if [ "$failed" -ne 0 ]; then
    echo -e "\n${RED}Pre-commit checks failed. Commit aborted.${NC}"
    exit 1
fi

echo -e "\n${GREEN}All pre-commit checks passed.${NC}"
