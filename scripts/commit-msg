#!/usr/bin/env bash
# commit-msg hook: enforce AGENTS.md §2.9 (independent agent review before commit).
#
# Cargo-free on purpose: this workspace builds only inside Docker (AGENTS.md §3.5), so the
# gate must not depend on a host toolchain. Install with `make install-hooks`, and re-run it
# after changing this file — the hook is a copy and nothing detects a stale installed one.
#
# A commit that touches code paths must carry both trailers, as the last paragraph of the
# message:
#
#     Reviewed-by: <reviewer agent / session id>
#     Review-scope: <merge-base sha>-<digest of the reviewed working state>
#
# A human waiver is allowed only where §2.9 permits it, and must be quoted:
#
#     Waived-by: <human> — <reason>
#
# What this hook does NOT do, so nobody over-trusts it:
#   - it is client-side, and it is best-effort by design: `make install-hooks` must have been run,
#     `--no-verify` skips it, `core.hooksPath` redirects it, and `git cherry-pick`, `git revert`
#     and `git am` do not invoke it at all (verified on git 2.43). `--amend` of a message alone and
#     `--allow-empty` do reach it, but with an empty staged diff, so they get past the gate rather
#     than past git;
#   - it checks the shape of Review-scope and that the sha names a real commit, but cannot
#     verify the digest;
#   - it exempts merge commits, so a conflict resolution is not covered;
#   - it enforces only part of the path-detectable waiver floor (§2.3 safety checks are not
#     path-detectable).
#
# Behavior is pinned by scripts/test-commit-msg.sh (`make hook-test`).
# No bash arrays: the hook must behave identically on bash 3.2 (macOS default).
set -euo pipefail

MSG_FILE=${1:?usage: commit-msg <commit message file>}

# A merge commit adds no new content of its own; review the parents instead.
# Keyed on MERGE_HEAD, not on the message text, so "Merge ..." cannot be forged.
if [ -e "$(git rev-parse --git-path MERGE_HEAD)" ]; then
    exit 0
fi

# Paths that count as a code change (AGENTS.md §2.9). Anything unlisted and not *.md is
# also treated as a code change.
is_code_path() {
    case "$1" in
        # Cargo.lock is committed (AGENTS.md §3.1) and a lock change is a dependency change,
        # so it always needs a review. rust-toolchain.toml is listed for clarity: an unlisted
        # non-*.md path already counts as code through the catch-all below.
        crates/*|Cargo.toml|Cargo.lock|rust-toolchain.toml|Makefile|Dockerfile*|scripts/*|configs/*|.github/*|.gitignore)
            return 0 ;;
        *.md)
            # Documentation that defines how the code is built and reviewed is not exempt.
            case "$1" in
                AGENTS.md|docs/BUILD*.md) return 0 ;;
                *) return 1 ;;
            esac ;;
        *) return 0 ;;
    esac
}

# Paths for which §2.9 says a waiver is never available. This is only part of the
# path-detectable floor; §2.3 safety checks cannot be detected from a path.
is_waiver_forbidden_path() {
    case "$1" in
        .github/*|crates/proto/proto/*|AGENTS.md|docs/BUILD*.md|scripts/commit-msg|scripts/test-commit-msg.sh) return 0 ;;
        *) return 1 ;;
    esac
}

# --no-renames so both sides of a rename are judged; otherwise `git mv AGENTS.md docs/x.md`
# would show only the destination and slip through as a plain *.md change.
# T is in the filter because a type change (regular file -> symlink) is the only staged change in
# some commits, and dropping it would let such a commit through unreviewed.
# core.quotePath=false so a non-ASCII path cannot escape the case patterns as "caf\303\251".
# NUL-separated names, because git also quotes names containing " or \ even with quotePath off,
# and a quoted name would dodge the waiver-floor patterns.
# The list goes through a temp file, NOT a process substitution: bash does not report a process
# substitution's exit status, so a failing `git` would leave the loop body unrun and the gate
# would fail OPEN and accept an unreviewed commit in silence. Fail closed instead.
STAGED=$(mktemp) || { echo "commit-msg: REJECTED: cannot create a temporary file." >&2; exit 1; }
trap 'rm -f "$STAGED"' EXIT
if ! git -c core.quotePath=false diff --cached --name-only -z --no-renames --diff-filter=ACMRDT > "$STAGED"; then
    echo "commit-msg: REJECTED (AGENTS.md §2.9): cannot list the staged paths; run the review and commit manually." >&2
    exit 1
fi

code_files=""
waiver_forbidden=""
while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    if is_code_path "$f"; then
        code_files+="$f"$'\n'
    fi
    if is_waiver_forbidden_path "$f"; then
        waiver_forbidden+="$f"$'\n'
    fi
done < "$STAGED"

[ -n "$code_files" ] || exit 0

# `git interpret-trailers --parse` reads the footer block only, so a "Reviewed-by: ..." line
# quoted inside the body is not picked up — and neither are trailers that a closing prose
# paragraph pushed out of the footer.
trailers=$(git interpret-trailers --parse < "$MSG_FILE")

problems=""
if ! grep -qE '^Reviewed-by:[[:space:]]*[^[:space:]]' <<< "$trailers"; then
    problems+="Reviewed-by: <reviewer agent / session id>"$'\n'
fi

# First Review-scope wins; awk exits after the match, so there is no SIGPIPE for
# `set -o pipefail` to turn into a silent failure (a `sed | head` pipeline would do exactly that).
scope=$(printf '%s\n' "$trailers" | awk '/^Review-scope:[[:space:]]*/{sub(/^Review-scope:[[:space:]]*/,""); print; exit}')
if [ -z "$scope" ]; then
    problems+="Review-scope: <merge-base sha>-<digest of the reviewed working state>"$'\n'
elif ! printf '%s' "$scope" | grep -qE '^[0-9a-f]{7,64}-[0-9a-f]{6,}$'; then
    problems+="Review-scope: '$scope' must be '<hex sha 7-64>-<hex digest 6+>'"$'\n'
elif ! git rev-parse --verify --quiet "${scope%%-*}^{commit}" >/dev/null; then
    problems+="Review-scope: '${scope%%-*}' is not a commit in this repository"$'\n'
fi

if [ -z "$problems" ]; then
    exit 0
fi

# Only now consider a waiver: a complete review is never vetoed by a stray Waived-by line.
if grep -qE '^Waived-by:[[:space:]]*[^[:space:]]' <<< "$trailers"; then
    if [ -n "$waiver_forbidden" ]; then
        {
            echo "commit-msg: REJECTED (AGENTS.md §2.9): a waiver is never available for these paths:"
            printf '%s\n' "${waiver_forbidden%$'\n'}"
            echo "See §2.9 'Waiver'. Split the change or run the review."
        } >&2
        exit 1
    fi
    echo "commit-msg: review waived by a human; recorded as a Waived-by: trailer."
    exit 0
fi

{
    echo "commit-msg: REJECTED (AGENTS.md §2.9)."
    echo
    echo "This commit touches code paths:"
    printf '%s\n' "${code_files%$'\n'}"
    echo "Problems:"
    printf '%s\n' "${problems%$'\n'}"
    echo "Trailers must be the last paragraph of the message; git only reads the footer block."
    echo "Run the review first (AGENTS.md §7.5): pre-finish gate green, then give the reviewer"
    echo "the cumulative branch diff plus the content of every untracked path, then commit with"
    echo "the trailers above. A human waiver goes in as 'Waived-by: <human> — <reason>', except"
    echo "for the paths §2.9 excludes."
} >&2
exit 1
